# Hugging Face API Configuration

# For using the AI Design Generator feature, you need a Hugging Face API token.
# 
# 1. Create an account at https://huggingface.co
# 2. Get your API token from https://huggingface.co/settings/tokens
# 3. Copy and paste your token below (remove the # comment)

# Your Hugging Face API Token (keep this private!)
VITE_HF_API_TOKEN=your_hf_token_here

# AI Model Configuration (optional - can be changed to other models)
VITE_AI_MODEL=ZB-Tech/Text-to-Image

# Note: Keep .env file in .gitignore to avoid exposing your token
